# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=4000
# Public URL customers use. Development: the Vite dev server. Production: your domain (https://...).
APP_URL=http://localhost:5173
# Required in production: a random string of 32+ characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=
# SQLite database file (default: ./data/vitara.db)
# DB_PATH=./data/vitara.db

# --- First admin account (created on first start when no admin exists) ---
ADMIN_EMAIL=admin@vitara.local
ADMIN_PASSWORD=Admin@12345

# --- AI assistant (Claude). Without a key the chatbot uses keyword matching. ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Payments (Stripe: card + PromptPay in THB). Without a key, a sandbox payment page is used in development. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Allow the sandbox payment page in production (for staging only)
# ALLOW_SANDBOX_PAYMENTS=false

# --- Email (Resend: https://resend.com). Without a key, emails are NOT sent; they are saved on the admin "อีเมล" page instead. ---
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend (onboarding@resend.dev only delivers to your own Resend account email).
# MAIL_FROM=Vitara <orders@yourdomain.com>
# MAIL_REPLY_TO=support@yourdomain.com

# --- Subscribe & Save discount (percent) ---
# SUBSCRIBE_DISCOUNT_PCT=10

# --- Where uploaded product photos are stored (default: ./data/uploads). Back this folder up together with the database. ---
# UPLOAD_DIR=./data/uploads
